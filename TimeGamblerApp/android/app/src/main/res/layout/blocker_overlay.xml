<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0b0b12"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="28dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/blocker_badge"
        android:paddingHorizontal="14dp"
        android:paddingVertical="6dp"
        android:fontFamily="@font/press_start_2p"
        android:text="BUSTED"
        android:textColor="#1a1d22"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/blocker_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:gravity="center"
        android:fontFamily="@font/press_start_2p"
        android:lineSpacingExtra="8dp"
        android:textColor="#f5b942"
        android:textSize="20sp" />

    <TextView
        android:id="@+id/blocker_reset"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="center"
        android:fontFamily="@font/vt323"
        android:textColor="#9ca6b4"
        android:textSize="22sp" />

    <Button
        android:id="@+id/blocker_home"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_marginTop="40dp"
        android:background="@drawable/blocker_button_primary"
        android:fontFamily="@font/press_start_2p"
        android:paddingBottom="4dp"
        android:paddingRight="4dp"
        android:stateListAnimator="@null"
        android:text="GO TO HOME SCREEN"
        android:textColor="#120d0d"
        android:textSize="12sp" />

    <Button
        android:id="@+id/blocker_open_app"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/blocker_button_secondary"
        android:fontFamily="@font/press_start_2p"
        android:paddingBottom="4dp"
        android:paddingRight="4dp"
        android:stateListAnimator="@null"
        android:text="OPEN TIME GAMBLER"
        android:textColor="#f3f5fb"
        android:textSize="11sp" />
</LinearLayout>
